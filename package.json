{
  "name": "sitegarden",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "perf": "tsx scripts/perf.ts",
    "dev:server": "UV_THREADPOOL_SIZE=16 tsx watch server/index.ts",
    "dev:web": "vite",
    "test": "tsx --test src/gen/gen.test.ts src/lib/view.test.ts server/plan.test.ts server/config.test.ts server/core/db.test.ts server/core/events.test.ts server/core/graph.test.ts server/core/holder.test.ts server/core/plugins.test.ts server/core/scheduler.test.ts server/core/secrets.test.ts server/core/http.test.ts server/app.test.ts server/sg.test.ts server/render.test.ts src/ext/tree.test.ts server/schema.test.ts",
    "sg": "UV_THREADPOOL_SIZE=16 tsx server/sg.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@resvg/resvg-js": "^2.6.2",
    "@xyflow/react": "^13.0.2",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
